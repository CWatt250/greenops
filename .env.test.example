# ---------------------------------------------------------------------------
# .env.test — configuration for the Playwright e2e suite (LOCAL ONLY)
#
# Copy this file to `.env.test` and fill in any secrets. The e2e tests NEVER
# touch the live/production Supabase project. They run against a local Supabase
# stack (`supabase start`) and a `next dev` server that Playwright boots itself.
#
#   cp .env.test.example .env.test
#   npx supabase start
#   node scripts/seed-e2e-users.mjs   # provisions the e2e owner + crew users
#   npm run test:e2e
#
# `.env.test` is gitignored. This `.example` is committed and contains only the
# well-known *local* Supabase demo keys (identical on every machine — they are
# fixtures, not secrets) plus throwaway test passwords.
# ---------------------------------------------------------------------------

# --- Local Supabase (from `npx supabase status -o env`) --------------------
# These anon/service keys are the standard local-dev demo JWTs. They are the
# same for everyone and only ever valid against http://127.0.0.1:54321.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# --- Mapbox ----------------------------------------------------------------
# A real public token (pk.*) is required for the FULL measure spec (address
# geocoding + satellite tiles + polygon drawing) and for the routes map to
# render. With the placeholder below, the measure full-flow test auto-skips and
# the rest of the suite still runs green. Get a token at https://mapbox.com.
NEXT_PUBLIC_MAPBOX_TOKEN=pk.placeholder

# --- OpenRouteService (VROOM route optimization, /api/optimize-route) ------
# Needed only for the routes.spec optimize flow. Free key:
# https://openrouteservice.org/dev/#/signup . Without it the optimize call
# fails and routes.spec reports it as a real backend dependency, not a pass.
ORS_API_KEY=your-ors-api-key

# --- E2E test users (provisioned by scripts/seed-e2e-users.mjs) ------------
# Throwaway credentials that only exist in the local Supabase auth schema.
E2E_OWNER_EMAIL=e2e-owner@tlc.com
E2E_OWNER_PASSWORD=e2e-Owner-Pass-123!
E2E_CREW_EMAIL=e2e-crew@tlc.com
E2E_CREW_PASSWORD=e2e-Crew-Pass-123!

# Seed company that the TLC seed migrations (017/020) populate.
E2E_COMPANY_ID=b2ddca19-8f06-4884-a1ca-9b3be5df8ecb
