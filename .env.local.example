NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_MAPBOX_TOKEN=your-mapbox-token

# OpenRouteService — used by /api/optimize-route to call the hosted VROOM
# optimization endpoint at https://api.openrouteservice.org/optimization.
# Server-only (no NEXT_PUBLIC_ prefix). Get a key at
# https://openrouteservice.org/dev/#/signup.
ORS_API_KEY=your-ors-api-key

# Transactional email (password resets, portal invites, proposals, invoices).
# Send-only Resend key restricted to the sending domain. Without it the app
# falls back to Supabase's mailer for auth links and to mailto/copy-link
# for proposals and invoices.
RESEND_API_KEY=re_your-key
EMAIL_FROM="TLC Management Platform <noreply@inbound.watt-systems.com>"
# Public origin used in emails sent from background code paths.
NEXT_PUBLIC_APP_URL=https://greenops-rho.vercel.app
