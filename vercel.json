{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "pdx1"
  ],
  "crons": [
    {
      "path": "/api/cron/generate-recurring-invoices",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/materialize-recurring-jobs",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/prune-crew-locations",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/send-reminders",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/cron/send-review-requests",
      "schedule": "30 * * * *"
    }
  ]
}
